@line  64,  42,  84,  42, white
@line  64,  42,  64,  58, white
@line 296,  42, 276,  42, white
@line 296,  42, 296,  58, white
@line  64, 198,  84, 198, white
@line  64, 198,  64, 182, white
@line 296, 198, 276, 198, white
@line 296, 198, 296, 182, white
# target box corners
@line 142,  92, 158,  92, white
@line 142,  92, 142, 106, white
@line 218,  92, 202,  92, white
@line 218,  92, 218, 106, white
@line 142, 148, 158, 148, white
@line 142, 148, 142, 134, white
@line 218, 148, 202, 148, white
@line 218, 148, 218, 134, white
# centre cross with a clear aiming gap
