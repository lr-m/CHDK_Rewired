@title Red dot sight
# Generated by tools/mkreticle.py - scaled 0.66 about the centre.
# Ring housing with cardinal ticks and a fine centre dot.
# Circles use ry = rx * 8/9 so they stay round on the 4:3 display.
@elps 180, 120, 40, 36, red_dark
@elps 180, 120, 39, 35, red_dark
@line 180, 85, 180, 92, red_dark
@line 180, 155, 180, 148, red_dark
@line 140, 120, 148, 120, red_dark
@line 220, 120, 212, 120, red_dark
@elps 180, 120, 5, 4, red_dark
@elpsf 180, 120, 3, 3, red
